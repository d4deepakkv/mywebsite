# --- OpenRouter (Claude) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional attribution headers shown on the OpenRouter dashboard
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Discovery Assistant

# --- Database ---
# async driver (asyncpg). Matches docker-compose defaults.
DATABASE_URL=postgresql+asyncpg://discovery:discovery@localhost:5432/discovery

# --- App ---
# Path to the bot configuration file (relative to the backend dir or absolute)
DISCOVERY_CONFIG=discovery_config.yaml
# Comma-separated list of allowed CORS origins for the React app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
